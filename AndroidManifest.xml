    android:versionName="1.5">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="Türkçe Q Klavye"
        android:allowBackup="false">

        <service
